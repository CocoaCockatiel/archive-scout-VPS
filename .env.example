# Create the token at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=replace_me

# Recommended: commands sync immediately to this server only.
DISCORD_GUILD_ID=

# Comma-separated Discord IDs. Configure at least one list.
# If both are empty, only server administrators can use the bot.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_ROLE_IDS=

# Keep this conservative unless your Discord server supports larger uploads.
DISCORD_MAX_UPLOAD_MB=8
LOG_LEVEL=INFO

# Optional for Archive Scout AI relevance features outside the normal bot workflow.
OPENAI_API_KEY=
